{
  "compilerOptions": {
    "composite": true,
    // A referenced project must emit, so send its output to a scratch dir
    // instead of dropping vite.config.js next to vite.config.ts — Vite
    // resolves the .js first and would silently load a stale config.
    "outDir": "./node_modules/.tmp/tsconfig.node",
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true
  },
  "include": ["vite.config.ts", "eslint.config.js"]
}
